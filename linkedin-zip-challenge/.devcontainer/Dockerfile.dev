# .devcontainer/Dockerfile.dev
# This Dockerfile is for the DEVELOPMENT environment.
# It sets up the Python environment but does not build the frontend.

FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-devel

RUN pip install --no-cache-dir uv

WORKDIR /app

COPY pyproject.toml uv.lock pytest.ini ./

RUN uv sync

COPY src ./src

ENV APP_PORT=7440

EXPOSE 7440

# `--reload` is the point of the dev image: compose mounts ./src over this path, so an
# edit on the host restarts the server. The container used to idle on `tail -f /dev/null`
# and expected `run_docker_dev.py` to exec the server into it, which never returned and
# left the health check unreachable.
CMD ["sh", "-c", "uv run uvicorn src.app.main:app --host 0.0.0.0 --port ${APP_PORT:-7440} --reload --reload-dir src"]