# .dockerignore

# Git
.git
.gitignore

# Python 虛擬環境
.venv
venv
*.venv
env/
.env

# Python 緩存
__pycache__/
*.pyc
.pytest_cache/

# Node.js (最可能的錯誤來源)
# 排除所有 node_modules 目錄，尤其是 Svelte 前端的
**/node_modules
node_modules/

# IDE / OS 特定檔案
.vscode/
.idea/
*.DS_Store
# Large local artifacts. None of these belong in an image, and `models/` alone is 6.6GB
# of checkpoints that would be copied into the build context on every build. The RL
# checkpoints the solver needs are mounted as a read-only volume at runtime instead --
# see docker-compose.yml -- so they stay out of the image without becoming unavailable.
datasets/
logs/
models/
puzzle_dataset/
zip_puzzles/
soft-delete/

# Notebooks are Colab artifacts kept for their executed output; the service never reads
# them.
notebooks/

# Test and lint caches
.ruff_cache/
htmlcov/
.coverage
