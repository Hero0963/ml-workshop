# .env
APP_HOST=127.0.0.1
APP_PORT=7440
SVELTE_PORT=5173

# --- Ollama ---
# Host port published by the ollama container in docker-compose.dev.yml.
# 11434 is deliberately avoided: other local stacks on the same machine already
# bind it, and the container name is likewise namespaced (zip_ollama_server).
OLLAMA_HOST_PORT=11435

# Where the vision-language backends send their requests.
# Inside the compose network (app container -> ollama service):
OLLAMA_PROVIDER_URL=http://zip_ollama_server:11434
# Running the app on the host instead (`uv run python -m src.app.main`):
# OLLAMA_PROVIDER_URL=http://127.0.0.1:11435

# Default vision model tag. See ai-collab/handover-vlm-parser.md for the
# measured baseline: qwen3.5:4b-q8_0 with reasoning disabled is the current
# best un-finetuned setting.
OLLAMA_MODEL_NAME=qwen3.5:4b-q8_0
