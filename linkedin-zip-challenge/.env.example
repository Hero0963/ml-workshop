# .env
APP_HOST=127.0.0.1
APP_PORT=7440
SVELTE_PORT=5173

# --- Ollama ---
# Host port published by the ollama container in docker-compose.dev.yml.
# 11434 is deliberately avoided: other local stacks on the same machine already
# bind it, and the container name is likewise namespaced (zip_ollama_server).
OLLAMA_HOST_PORT=11435

# Where the vision-language backends send their requests.
# This value is the HOST-side address, which is how `uv run python -m src.app.main`
# runs. The app container does not use it: docker-compose.dev.yml overrides it with
# the compose-internal address, because `environment:` wins over `env_file:`.
OLLAMA_PROVIDER_URL=http://127.0.0.1:11435/v1

# Default vision model tag. `zip-qwen35-4b-p4c:f16` is the P4c fine-tuned model,
# imported with `ollama create` from a locally merged checkpoint -- see
# ai-collab/handover-vlm-parser.md for how to produce it. It must be paired with the
# `finetune` prompt variant; the baseline few-shot prompt asks it a question it never
# saw during training.
OLLAMA_MODEL_NAME=zip-qwen35-4b-p4c:f16
# Must match what the model was trained on: `finetune` for the fine-tuned tag,
# `sized` for an un-finetuned one. Changing the model without changing this asks
# the checkpoint a question it never saw.
VISION_PROMPT_VARIANT=finetune

# Un-finetuned fallback, the best measured baseline setting (2026-08-15). Use this if
# the fine-tuned model has not been imported yet; expect wall F1 around 0.44.
# OLLAMA_MODEL_NAME=qwen3.5:4b-q8_0
# VISION_PROMPT_VARIANT=sized

# Where /api/vision/solve keeps a copy of each uploaded image and what the model
# said, in the same shape as a training dataset (images/ + metadata.jsonl). Adding a
# hand-written `label` to a line makes it scoreable by score_predictions, which is
# the cheapest way to build a real-screenshot evaluation set. Empty disables it.
# The folder is git-ignored.
VISION_LOG_DIR=logs/vision
